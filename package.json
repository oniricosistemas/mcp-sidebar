{
  "name": "pi-mcp-sidebar",
  "version": "0.1.0",
  "description": "A responsive MCP server sidebar for Pi and gentle-shell.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "gentle-shell",
    "mcp",
    "tui",
    "sidebar"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oniricosistemas/mcp-sidebar.git"
  },
  "files": [
    "assets/",
    "src/",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "pnpm test && pnpm typecheck"
  },
  "pi": {
    "image": "./assets/gentle-logo-only.png",
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.2.0",
    "@earendil-works/pi-tui": ">=1.2.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@11.1.1"
}
